{
  "loc.friendlyName": "Pipeline Packer tool installer",
  "loc.helpMarkDown": "[Learn more about this task](https://github.com/sethbacon/azure-pipelines-packer)",
  "loc.description": "Find in cache or download a specific version of Packer and prepend it to the PATH",
  "loc.instanceNameFormat": "Install Packer $(packerVersion)",
  "loc.input.label.packerVersion": "Version",
  "loc.input.help.packerVersion": "The version of Packer to install. Use 'latest' to install the current latest release.",
  "loc.input.label.downloadSource": "Download source",
  "loc.input.help.downloadSource": "Where to download the Packer binary from.",
  "loc.input.label.registryUrl": "Registry base URL",
  "loc.input.help.registryUrl": "Base URL of your terraform-registry-backend instance. Must use HTTPS. Example: https://registry.example.com",
  "loc.input.label.registryMirrorName": "Mirror configuration name",
  "loc.input.help.registryMirrorName": "The mirror configuration name in your registry backend. This is the {name} path segment in /terraform/binaries/{name}/...",
  "loc.input.label.registryAllowedHosts": "Allowed registry download hosts",
  "loc.input.help.registryAllowedHosts": "Optional comma- or newline-separated allowlist of the storage hosts the registry may hand the binary download off to. A `*.` prefix matches subdomains only (e.g. `*.s3.amazonaws.com`). The allowlist is enforced on the initial download URL and re-checked on every redirect hop. When empty (default), the registry may name any public host, but a host that is — or resolves to — a loopback, link-local/metadata (169.254.0.0/16), carrier-grade-NAT, or RFC1918/ULA private address is refused; set this to pin a registry that legitimately serves from a private or air-gapped storage host.",
  "loc.input.label.mirrorBaseUrl": "Mirror base URL",
  "loc.input.help.mirrorBaseUrl": "Base URL of your binary mirror. Must use HTTPS. Must serve files at the same path structure as releases.hashicorp.com/packer.",
  "loc.input.label.mirrorAllowedHosts": "Allowed mirror hosts",
  "loc.input.help.mirrorAllowedHosts": "Optional comma- or newline-separated host allowlist for private or air-gapped mirrors. A `*.` prefix matches subdomains only. The allowlist is enforced on the initial download URL and re-checked on every redirect hop. When empty (default), a host that is — or resolves to — a loopback, link-local/metadata (169.254.0.0/16), carrier-grade-NAT, or RFC1918/ULA private address is refused, on the initial URL and on every redirect hop alike. Addresses are classified numerically, so short-form/decimal/octal/hex IPv4 and IPv4-mapped IPv6 spellings are covered. Note that the default-deny check resolves DNS at check time and does not pin the resulting address into the connection, so it is defense-in-depth against a host that statically points at a private address rather than a complete defense against active DNS rebinding.",
  "loc.input.label.requireGpgSignature": "Require GPG signature verification",
  "loc.input.help.requireGpgSignature": "When enabled, fail if the GPG signature file is unavailable. Defaults to true for HashiCorp downloads. Disable for mirrors that do not serve .sig files.",
  "loc.input.label.requireChecksum": "Require checksum verification",
  "loc.input.help.requireChecksum": "When enabled (default), fail if the mirror or registry does not provide a SHA256 checksum for the requested version. Disable only if your mirror/registry cannot publish checksums and you trust it to verify server-side.",
  "loc.messages.VerifyPackerInstallation": "Verifying Packer installation...",
  "loc.messages.InputVersionNotValidSemanticVersion": "Input version %s is not a valid semantic version",
  "loc.messages.PackerNotFoundInFolder": "Packer executable not found in path %s",
  "loc.messages.OperatingSystemNotSupported": "Operating system %s is not supported",
  "loc.messages.ArchitectureNotSupported": "Architecture %s is not supported",
  "loc.messages.PackerDownloadFailed": "Failed to download Packer from url %s. Error: %s",
  "loc.messages.PackerVersionNotFound": "Unable to get latest version from source, using fallback version",
  "loc.messages.GettingLatestPackerVersion": "Getting latest Packer version.",
  "loc.messages.InsecureUrlRejected": "Insecure URL rejected: %s. Only HTTPS URLs are allowed.",
  "loc.messages.MirrorDownloadHostIsPrivate": "Mirror download host %s is private or link-local and was rejected. Configure mirrorAllowedHosts to explicitly allow a trusted private mirror.",
  "loc.messages.MirrorDownloadHostNotAllowed": "Mirror download host %s is not in mirrorAllowedHosts (%s).",
  "loc.messages.RegistryDownloadHostIsPrivate": "Registry download host %s is private or link-local and was rejected. Configure registryAllowedHosts to explicitly allow a trusted private storage host.",
  "loc.messages.RegistryDownloadHostNotAllowed": "Registry download host %s is not in registryAllowedHosts (%s).",
  "loc.messages.RegistryRequestFailed": "Registry request failed for %s. HTTP status: %s",
  "loc.messages.Sha256VerificationFailed": "SHA256 verification failed. Expected: %s, Got: %s",
  "loc.messages.ResolvingLatestFromRegistry": "Resolving latest Packer version from registry: %s",
  "loc.messages.ResolvedVersionFromRegistry": "Resolved latest version from registry: %s"
}
